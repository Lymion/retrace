# Copy this file to .env and fill in what you need. Never commit .env.

# --- AI provider: api-key mode -------------------------------------------
# Only needed if you use the "api-key" provider. Billed per token on the API.
# Leave empty to use the "claude-login" provider (your own Claude login).
ANTHROPIC_API_KEY=

# Models used by the tutor. Settings can override these.
TUTOR_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# --- GitHub ----------------------------------------------------------------
# Optional. Only needed for private repos. Use a fine-grained token with
# read-only "Contents" access. It is sent to GitHub only, never logged.
GITHUB_TOKEN=

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_FILES=5000
# AI requests allowed per minute (all AI routes together)
AI_RATE_LIMIT_PER_MIN=20

# --- Storage -----------------------------------------------------------------
# Folder for the SQLite database and temporary extraction folders.
RETRACE_DATA_DIR=data

# --- Extensions ----------------------------------------------------------------
# Optional. A JSON file of outside notes the tutor should see (for example from a
# screen-annotation tool). See docs/extending.md for the format.
RETRACE_CONTEXT_FILE=
