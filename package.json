{
  "name": "retrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn app development by rebuilding your own finished projects, level by level.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "samples:zip": "tsx scripts/make-sample-zips.ts",
    "live-check": "tsx scripts/live-check.ts",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@anthropic-ai/sdk": "^1.3.0",
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "isomorphic-git": "^1.44.7",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "5.9.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
